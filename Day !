##Operators

#Arithmetic
a=int(input("Enter a:"))
b=int(input("Enter b:"))
print("Add:",a+b)
print("Sub:",a-b)
print("Mult:",a*b)
print("Div:",a/b)
print("Modulus:",a%b)-->Gives the Reminder
print("Exponential:",a**b)-->Gives the Exponential value
print("Floor Div:",a//b)-->Gives the Quotient

